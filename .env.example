# Copy to .env and fill in. All keys are optional — Jarvis degrades to keyless
# public endpoints for anything it has no key for, and says so when asked.

# Alchemy — EVM RPC, Portfolio API, Prices API. https://dashboard.alchemy.com
ALCHEMY_API_KEY=

# Helius — Solana RPC, DAS, Enhanced Transactions. https://dashboard.helius.dev
HELIUS_API_KEY=

# Optional
# DUNE_API_KEY=
# ARKHAM_API_KEY=

# ── Google Calendar & Meet (optional) ────────────────────────────────────────
# Desktop-app OAuth client from https://console.cloud.google.com/
#   APIs & Services -> Credentials -> OAuth client ID -> Desktop app
# Enable "Google Calendar API" (and "Google Meet API" for instant rooms).
# The "secret" is not secret for installed apps — Google's own flow puts it in
# the binary — which is why the exchange also uses PKCE. See googleCalendar.js.
#
# NOTE: creating a Google Meet LINK requires a paid Google Workspace account.
# On a personal Gmail the event is created without one, and Jarvis says so
# rather than pretending a link exists.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
