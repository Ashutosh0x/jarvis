    <!-- Offline APK share -->
    <string name="share_activity_label">JARVIS Share</string>
    <string name="share_title">Offline APK share</string>
    <string name="share_subtitle">Phone to phone over the radio. No internet, no router, no cloud — the bytes never leave the two devices.</string>
    <string name="share_transport_label">CONNECTION</string>
    <string name="share_transport_direct">Wi-Fi Direct</string>
    <string name="share_transport_lan">Same Wi-Fi</string>
    <string name="share_hint_direct">Builds a private link between the two phones. Nothing else needs to exist.</string>
    <string name="share_hint_lan">Use when both phones already sit on one network. Faster to start, and still local-only.</string>

    <string name="share_send_self">Send JARVIS itself</string>
