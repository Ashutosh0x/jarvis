{
  "name": "@ashutosh0x/jarvis",
  "version": "0.3.0",
  "description": "A local-first desktop AI assistant: federated live web search with no API key, on-device vision and OCR, neural TTS, and a self-healing supervisor. Ships as an Electron app and an importable search library.",
  "main": "electron.js",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "eval": "node eval/retrieval-eval.mjs && node eval/memory-eval.mjs && node eval/answer-eval.mjs",
    "dev": "vite",
    "build": "vite build",
    "electron": "node node_modules/electron/cli.js .",
    "electron:dev": "set NODE_ENV=development&& node node_modules/electron/cli.js .",
    "electron:build": "vite build && electron-builder",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && npm run build && electron-builder --publish never",
    "dist:win": "npm run icon && npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run icon && npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run icon && npm run build && electron-builder --linux --publish never",
    "dist:all": "npm run build && electron-builder -mwl --publish never",
    "checksums": "node scripts/checksums.mjs",
    "checksums:verify": "node scripts/checksums.mjs --verify",
    "smoke": "node scripts/smoke-test.mjs",
    "release": "npm run build && electron-builder --publish always",
    "favicons": "node scripts/make-favicons.mjs",
    "icons": "npm run icon && npm run favicons",
    "prepack": "npm run build",
    "jarvis": "node bin/jarvis.mjs"
  },
  "keywords": [
    "ai",
    "assistant",
    "electron",
    "desktop",
    "voice-assistant",
    "web-search",
    "search-engine",
    "rrf",
    "bm25",
    "gemini",
    "ollama",
    "local-first",
    "tts",
    "ocr",
    "rag",
    "offline-first",
    "jarvis"
  ],
  "author": {
    "name": "Ashutosh Kumar Singh",
    "email": "ashutoshkumarsingh0x@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.34.0",
    "axios": "^1.6.0",
    "bonjour-service": "^1.4.3",
    "chokidar": "^5.0.0",
    "dat.gui": "^0.7.9",
    "electron-updater": "^6.6.2",
    "pdf-to-img": "^6.2.0",
    "qrcode": "^1.5.4",
    "three": "^0.158.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@parcel/config-default": "^2.4.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "parcel": "^2.7.0",
    "parcel-reporter-static-files-copy": "^1.3.4",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashutosh0x/jarvis.git"
  },
  "homepage": "https://github.com/Ashutosh0x/jarvis#readme",
  "bugs": {
    "url": "https://github.com/Ashutosh0x/jarvis/issues"
  },
  "bin": {
    "jarvis": "bin/jarvis.mjs"
  },
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./webSearch.js"
    },
    "./search": "./webSearch.js",
    "./metrics": "./metricStore.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "setup/",
    "lib/",
    "dist/",
    "src/",
    "server/",
    "companion/",
    "build/icon.png",
    "autostart.js",
    "googleCalendar.js",
    "electron.js",
    "preload.js",
    "webSearch.js",
    "metricStore.js",
    "rpcHedge.js",
    "sectorMove.js",
    "visionRouter.js",
    "streamGuard.js",
    "edgarGuard.js",
    "chainProviders.js",
    "chainWatch.js",
    "companionBridge.js",
    "adbService.js",
    "vite.config.js",
    ".env.example",
    "README.md",
    "LICENSE",
    "!dist/*.mp3"
  ],
  "optionalDependencies": {
    "electron": "^39.2.4"
  }
}
